# Issue #109 — standard Greenfield installation (0.44.2); use a separate real .env.
# Pin a matching v0.44.2 App/Migrator image pair in a safe internal deployment.
# Do NOT use the older DB volumes in CAD_DATA_VOLUME_NAME. Never put setup codes in .env.
# GHCR_IMAGE=ghcr.io/planner77/layoutmanager:0.44.2
# GHCR_MIGRATION_IMAGE=ghcr.io/planner77/layoutmanager:0.44.2-migrate
# Unique name for a brand-new EMPTY DB+CAD Docker volume.
CAD_DATA_VOLUME_NAME=cad-layout-viewer-greenfield-install-v1
# Exact browser-visible scheme/host/port. Must agree with Host and POST Origin.
G7_RUNTIME_ORIGIN=http://localhost:3000
# Internal LAN HTTP only behind host firewall / restricted network; use false with TLS.
G7_RUNTIME_ALLOW_HTTP=true
# Optional traceability: deployed Git source SHA, 40 lowercase hex characters.
G7_RELEASE_SOURCE_COMMIT=

# Existing GitHub variable names are preserved. Never put real values here.
# GitHub HTTPS repository URL, without embedded credentials
remote_repo_url=
# GitHub access token: Git tooling only; never load into a browser bundle
remote_repo_token=

# Application configuration; Git credentials remain separate.
# SQLite file URL; use an absolute file:/... path to avoid cwd ambiguity.
DATABASE_URL=
# Absolute local CAD storage directory, outside src/public
CAD_STORAGE_PATH=
# Upload limit in MiB (1 MiB = 1,048,576 bytes); default: 100
MAX_UPLOAD_SIZE_MB=

# Structured logging. production/Docker 권장값: info + json
# debug | info | warn | error
LOG_LEVEL=info
# json | pretty (Docker/production은 json 권장)
LOG_FORMAT=json
# Optional app-owned private JSONL under /data/logs, independent of Docker local driver.
LOG_STORE_ENABLED=true
# Valid days 1..30 (default 7); invalid values fall back to bounded defaults.
LOG_RETENTION_DAYS=7
# Total MiB 4..256 (default 64); per-file MiB 1..8 (default 4).
LOG_MAX_TOTAL_MB=64
LOG_MAX_FILE_MB=4

# New uploads: local (default) or s3. Existing files retain their recorded backend.
CAD_STORAGE_BACKEND=local
# S3-compatible HTTP(S) origin without a path or embedded credentials
CAD_S3_ENDPOINT=
CAD_S3_BUCKET=
CAD_S3_REGION=us-east-1
# Server-only credentials; never use NEXT_PUBLIC_*
CAD_S3_ACCESS_KEY_ID=
CAD_S3_SECRET_ACCESS_KEY=
CAD_S3_SESSION_TOKEN=
# SeaweedFS typically uses path-style addressing
CAD_S3_FORCE_PATH_STYLE=true
CAD_S3_TIMEOUT_MS=60000

# Docker Compose에서 사용할 image 이름이다. 비우면 로컬 cad-layout-viewer:local을 사용한다.
# 실제 GHCR repository는 배포 환경에서 지정하며 이 예시 파일에는 넣지 않는다.
GHCR_IMAGE=
# Optional explicit migration reference. Required when GHCR_IMAGE uses @sha256 digest.
# Docker Compose directly derives :tag-migrate only from TAGGED GHCR_IMAGE.
# For tagless GHCR_IMAGE, use 'bash src/scripts/compose.sh .env up -d' to normalize
# app=:latest and migration=:latest-migrate, or set GHCR_MIGRATION_IMAGE explicitly.
# Default local migration image: cad-layout-viewer:local-migrate.
GHCR_MIGRATION_IMAGE=
# Host의 localhost와 LAN IP에 공개할 HTTP port이다.
CAD_HOST_PORT=3000

# Issue #96 DESIGN ONLY — DO NOT ENABLE IN PRODUCTION.
# These ADMIN_* variables are NOT currently consumed by app/Compose/migrator.
# Never place passwords in .env; provide a restricted absolute secret-file path.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD_FILE=
ADMIN_RECOVERY_ENABLED=false
ADMIN_RECOVERY_TARGET_USER_ID=
# One-use recovery identifier, durable replay defense required before operation
ADMIN_RECOVERY_ONCE_ID=
ADMIN_RECOVERY_PASSWORD_FILE=
