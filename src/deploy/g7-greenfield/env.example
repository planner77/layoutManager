# Copy to .env.greenfield and replace all placeholders locally (never commit).
GHCR_IMAGE=ghcr.io/planner77/layoutmanager:0.44.1@sha256:REPLACE_CURRENT_APP_DIGEST
GHCR_MIGRATION_IMAGE=ghcr.io/planner77/layoutmanager:0.44.1-migrate@sha256:REPLACE_CURRENT_MIGRATOR_DIGEST
G7_RELEASE_VERSION=0.44.1
G7_RELEASE_SOURCE_COMMIT=REPLACE_40_HEX_RELEASE_SOURCE_COMMIT
G7_RELEASE_APP_DIGEST=sha256:REPLACE_CURRENT_APP_DIGEST
G7_RELEASE_MIGRATOR_DIGEST=sha256:REPLACE_CURRENT_MIGRATOR_DIGEST
CAD_GREENFIELD_HOST_PORT=3001
G7_RUNTIME_ALLOW_HTTP=true
G7_SITE_SEED_DIR=/srv/layoutmanager/greenfield-seed
G7_SITE_OPERATOR_DIR=/srv/layoutmanager/greenfield-operator
G7_RUNTIME_DIR=/srv/layoutmanager/greenfield-runtime
G7_OWNER_KEY_DIR=/srv/layoutmanager/greenfield-owner
G7_ADMIN_SECRET_DIR=/srv/layoutmanager/greenfield-secret
G7_INITIAL_ADMIN_USERNAME=admin
G7_AUTH_ENABLED=true
G7_CAD_WRITE_CUTOVER_ENABLED=true
